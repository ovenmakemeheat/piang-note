---
const links = [
	{ label: "blog", to: "/blog/" },
	{ label: "archive", to: "/archive/" },
	{ label: "projects", to: "/projects/" },
	{ label: "about", to: "/about/" },
];
const pathname = Astro.url.pathname;
const isCurrent = (to: string) => pathname === to || pathname.startsWith(to);
---

<header class="site-header">
	<div class="site-brand">
		<a class="site-brand-link" href="/about/">
			<img src="/images/guntee-profile.jpg" alt="" width="32" height="32" />
			<span>Guntee Doungmanee</span>
		</a>’s Notes and Writing
	</div>
	<nav aria-label="Primary navigation" class="site-nav">
		{
			links.map((link) => (
				<a
					href={link.to}
					class:list={["nav-link", isCurrent(link.to) && "is-current"]}
					aria-current={isCurrent(link.to) ? "page" : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>
