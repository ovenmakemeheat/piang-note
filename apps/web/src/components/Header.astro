---
import { Image } from "astro:assets";
import portrait from "../assets/guntee-profile.jpg";

const links = [
	{ label: "blog", to: "/blog/" },
	{ label: "archive", to: "/archive/" },
	{ label: "projects", to: "/projects/" },
	{ label: "about", to: "/about/" },
];
const pathname = Astro.url.pathname;
const isCurrent = (to: string) => pathname === to || pathname.startsWith(to);
---

<header class="site-header" transition:persist="site-header">
	<div class="site-brand">
		<a class="site-brand-link" href="/about/">
			<Image src={portrait} alt="" width={64} loading="eager" />
			<span>Guntee Doungmanee</span>
		</a>’s Notes and Writing
	</div>
	<nav aria-label="Primary navigation" class="site-nav">
		{
			links.map((link) => (
				<a
					href={link.to}
					class:list={["nav-link", isCurrent(link.to) && "is-current"]}
					aria-current={isCurrent(link.to) ? "page" : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<script>
	const updateCurrentLink = () => {
		for (const link of document.querySelectorAll<HTMLAnchorElement>(".site-nav a")) {
			const isCurrent =
				window.location.pathname === link.pathname ||
				window.location.pathname.startsWith(link.pathname);
			link.classList.toggle("is-current", isCurrent);
			if (isCurrent) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		}
	};

	updateCurrentLink();
	document.addEventListener("astro:page-load", updateCurrentLink);
</script>
