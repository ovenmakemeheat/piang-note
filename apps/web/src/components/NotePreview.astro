---
import type { Note } from "../lib/content";

interface Props {
	compact?: boolean;
	note: Note;
	showTags?: boolean;
}

const { compact = false, note, showTags = false } = Astro.props;
const date = note.publishedAt
	? new Intl.DateTimeFormat("en", {
			day: "numeric",
			month: "short",
			year: "numeric",
		}).format(new Date(note.publishedAt))
	: "undated";
---

<article class:list={["entry-overview", compact && "entry-overview--compact"]}>
	<div class="entry-date">
		<time datetime={note.publishedAt}>{date}</time>
	</div>
	<div class="entry-detail">
		<h2 class="entry-title entry-title--post">
			<a href={`/blog/${note.slug}/`}>{note.title}</a>
		</h2>
		{!compact && note.excerpt && <p class="entry-summary">{note.excerpt}</p>}
		{
			showTags && note.categories.length > 0 && (
				<ul class="entry-categories" aria-label="Tags">
					{note.categories.map((category, index) => (
						<li>
							{index > 0 && <span aria-hidden="true"> / </span>}
							<a href={`/categories/${category.slug}/`}>{category.title}</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</article>
