---
import "../styles/global.css";
import BlobField from "../components/BlobField.astro";
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";
import { absoluteUrl, canonicalPath, PERSON_ID, SITE_NAME, SITE_URL, serializeJsonLd } from "../lib/seo";

interface Props {
	description?: string;
	indexable?: boolean;
	ogType?: "website" | "article";
	publishedAt?: string;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	title?: string;
	updatedAt?: string;
	wide?: boolean;
}

const {
	description = "Notes and projects by Guntee Doungmanee, a computer engineering student at KMUTT working across AI, software, and research.",
	indexable = true,
	ogType = "website",
	publishedAt,
	structuredData,
	title = "Guntee Doungmanee | Notes, Projects, and Research",
	updatedAt,
	wide = false,
} = Astro.props;
const canonicalUrl = absoluteUrl(canonicalPath(Astro.url.pathname));
const socialImageUrl = absoluteUrl("/images/site-preview-square.jpg");
const websiteId = `${SITE_URL}/#website`;
const siteSchema = [
	{
		"@type": "WebSite",
		"@id": websiteId,
		url: absoluteUrl("/"),
		name: SITE_NAME,
		description: "Personal website, blog, and project portfolio of Guntee Doungmanee.",
		inLanguage: "en",
		publisher: { "@id": PERSON_ID },
	},
	{
		"@type": "Person",
		"@id": PERSON_ID,
		name: SITE_NAME,
		alternateName: ["Piang", "ovenmakemeheat"],
		url: absoluteUrl("/about/"),
		image: absoluteUrl("/images/guntee-profile.jpg"),
		sameAs: [
			"https://github.com/ovenmakemeheat",
			"https://linkedin.com/in/gunteed",
			"https://www.facebook.com/guntee.doungmanee/",
			"https://www.instagram.com/pianfff/",
			"https://x.com/microhum",
			"https://www.kmutt.me/guntee_cv",
		],
	},
	{
		"@type": "WebPage",
		"@id": `${canonicalUrl}#webpage`,
		url: canonicalUrl,
		name: title,
		description,
		isPartOf: { "@id": websiteId },
		inLanguage: "en",
		...(canonicalUrl === absoluteUrl("/about/") ? { mainEntity: { "@id": PERSON_ID } } : {}),
	},
];
const pageStructuredData = structuredData
	? Array.isArray(structuredData)
		? structuredData
		: [structuredData]
	: [];
const jsonLd = serializeJsonLd({
	"@context": "https://schema.org",
	"@graph": [...siteSchema, ...pageStructuredData],
});
---

<!doctype html>
<html lang="en" data-theme="dark" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#282828" />
		<script is:inline>
			try {
				const savedScheme = localStorage.getItem("piang-note-color-scheme");
				if (["auto", "light", "dark"].includes(savedScheme)) {
					document.documentElement.dataset.theme = savedScheme;
				}
			} catch {}
		</script>
		<link rel="icon" type="image/png" sizes="128x128" href="/favicon-square.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-square.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Ubuntu+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="author" content={SITE_NAME} />
		<meta name="description" content={description} />
		<meta name="robots" content={indexable ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" : "noindex, nofollow"} />
		{indexable && <link rel="canonical" href={canonicalUrl} />}
		<link rel="sitemap" type="application/xml" href={absoluteUrl("/sitemap.xml")} />
		<link rel="alternate" type="application/atom+xml" href={absoluteUrl("/feed.xml")} title={`${SITE_NAME} — Notes and Writing`} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:secure_url" content={socialImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="1200" />
		<meta property="og:image:alt" content="Portrait of Guntee Doungmanee." />
		{ogType === "article" && publishedAt && <meta property="article:published_time" content={publishedAt} />}
		{ogType === "article" && updatedAt && <meta property="article:modified_time" content={updatedAt} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:site" content="@microhum" />
		<meta name="twitter:creator" content="@microhum" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="Portrait of Guntee Doungmanee." />
		<script is:inline type="application/ld+json" set:html={jsonLd}></script>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<BlobField position="top" />
		<div class:list={["site-shell", wide && "site-shell--wide"]}>
			<Header />
			<main id="main-content">
				<slot />
			</main>
			<footer class="site-footer" transition:persist="site-footer">
				<p>© Copyright {new Date().getFullYear()} by Guntee Doungmanee.</p>
				<p>
					Contact me via <a href="mailto:Guntee12123@gmail.com">email</a>,
					<a href="https://www.facebook.com/guntee.doungmanee/">Facebook</a>, or
					<a href="https://www.instagram.com/pianfff/">Instagram</a>. You can also find me on
					<a href="https://x.com/microhum">X</a>,
					<a href="https://linkedin.com/in/gunteed">LinkedIn</a>, and
					<a href="https://github.com/ovenmakemeheat">GitHub</a>.
				</p>
				<p>
					Inspired by <a href="https://lucumr.pocoo.org/">Armin Ronacher’s blog</a>.
					Built with <a href="https://astro.build/">Astro</a>.
				</p>
				<p class="color-scheme-control" role="group" aria-label="Color scheme">
					Color scheme:
					<button type="button" data-color-scheme="auto" aria-pressed="false">auto</button>,
					<button type="button" data-color-scheme="light" aria-pressed="false">light</button>,
					<button type="button" data-color-scheme="dark" aria-pressed="true">dark</button>.
				</p>
			</footer>
		</div>
		<BlobField position="bottom" />
		<script>
			const root = document.documentElement;
			const schemeKey = "piang-note-color-scheme";
			const validSchemes = ["auto", "light", "dark"];

			const syncColorScheme = () => {
				const scheme = root.dataset.theme || "auto";
				for (const button of document.querySelectorAll<HTMLButtonElement>("[data-color-scheme]")) {
					button.setAttribute("aria-pressed", String(button.dataset.colorScheme === scheme));
				}
				const pageColor = getComputedStyle(root).getPropertyValue("--palette-page").trim();
				const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
				if (themeColor && pageColor) themeColor.content = pageColor;
			};

			const restoreColorScheme = () => {
				try {
					const savedScheme = localStorage.getItem(schemeKey);
					if (savedScheme && validSchemes.includes(savedScheme)) root.dataset.theme = savedScheme;
				} catch {}
				syncColorScheme();
			};

			document.addEventListener("click", (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;
				const button = target.closest<HTMLButtonElement>("[data-color-scheme]");
				const scheme = button?.dataset.colorScheme;
				if (!scheme || !validSchemes.includes(scheme)) return;
				root.dataset.theme = scheme;
				try {
					localStorage.setItem(schemeKey, scheme);
				} catch {}
				syncColorScheme();
			});

			window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", syncColorScheme);
			document.addEventListener("astro:after-swap", restoreColorScheme);
			document.addEventListener("astro:page-load", syncColorScheme);
			restoreColorScheme();
		</script>
	</body>
</html>
