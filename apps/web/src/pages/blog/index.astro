---
import NotePreview from "../../components/NotePreview.astro";
import Layout from "../../layouts/Layout.astro";
import { getNotes } from "../../lib/content";

const posts = await getNotes();
---

<Layout
	title="Computing, AI, and Engineering Notes | Guntee Doungmanee"
	description="Read notes by Guntee Doungmanee on computing, machine learning, software engineering, and projects exploring technology in practice."
>
	<div class="page-shell page-shell--home">
		<h1 class="visually-hidden">Blog</h1>
		<div class="entry-list">
			{posts.map((post) => <NotePreview note={post} />)}
		</div>
	</div>
</Layout>
