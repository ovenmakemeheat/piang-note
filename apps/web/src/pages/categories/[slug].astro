---
import NotePreview from "../../components/NotePreview.astro";
import Layout from "../../layouts/Layout.astro";
import { getCategory, getNotesByCategory } from "../../lib/content";

const { slug } = Astro.params;
const category = slug ? await getCategory(slug) : undefined;

if (!category) {
	return Astro.redirect("/categories/");
}

const posts = await getNotesByCategory(category.slug);
---

<Layout title={`${category.title} | Piang Note`} description={category.description}>
	<div class="page-shell page-shell--compact">
		<p class="breadcrumb"><a href="/categories/">Tags</a><span aria-hidden="true">/</span>{category.title}</p>
		<section class="page-intro page-intro--tight" aria-labelledby="page-title">
			<h1 class="page-title" id="page-title">{category.title}</h1>
			{category.description && <p class="page-lede">{category.description}</p>}
		</section>

		<section aria-labelledby="entries-heading">
			<div class="section-heading">
				<h2 id="entries-heading">Posts</h2>
			</div>
			{posts.length > 0 ? (
				<div class="entry-list">
					{posts.map((note) => <NotePreview note={note} />)}
				</div>
			) : (
				<p class="empty-note">No posts with this tag yet.</p>
			)}
		</section>
	</div>
</Layout>
