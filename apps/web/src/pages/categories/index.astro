---
import Layout from "../../layouts/Layout.astro";
import { getCategories, getNotes } from "../../lib/content";

const [categories, notes] = await Promise.all([getCategories(), getNotes()]);
---

<Layout
	title="Topics in Computing and AI | Guntee Doungmanee"
	description="Browse tags across Guntee Doungmanee’s public writing on computing, machine learning, and engineering."
>
	<div class="page-shell page-shell--compact">
		<section class="page-intro page-intro--tight" aria-labelledby="page-title">
			<h1 class="page-title" id="page-title">Tags</h1>
		</section>

		<ul class="category-index">
			{
				categories.map((category) => {
					const count = notes.filter((note) =>
						note.categories.some((item) => item.slug === category.slug),
					).length;

					return (
						<li class="category-index-row">
							<div>
								<h2><a href={`/categories/${category.slug}/`}>{category.title}</a></h2>
								{category.description && <p>{category.description}</p>}
							</div>
							<span class="index-count">{count} {count === 1 ? "post" : "posts"}</span>
						</li>
					);
				})
			}
		</ul>
	</div>
</Layout>
