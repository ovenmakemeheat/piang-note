---
import Layout from "../../layouts/Layout.astro";
import { getMarkdownPage } from "../../lib/content";

const page = await getMarkdownPage("projects");
if (!page) throw new Error("Missing Markdown page: projects");
const Content = page.Content;
---

<Layout
	title="AI, Research, and Software Projects | Guntee Doungmanee"
	description="Explore Guntee Doungmanee’s work in clinical AI, Thai language technology, healthtech, machine learning, and game development."
>
	<div class="page-shell page-shell--compact">
		<article class="markdown-page">
			<Content />
		</article>
	</div>
</Layout>
